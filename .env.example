# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the browser.
# Used by cron/admin routes (approving accounts, sending reminder emails).
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) - for deadline reminder emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Monitoring Skripsi <no-reply@yourdomain.com>"

# Secret used to authorize the daily cron endpoint (Vercel Cron sends this header)
CRON_SECRET=

# Public site URL (used in emails for links back to the app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
